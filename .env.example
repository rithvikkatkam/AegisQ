# Copy this file to `.env` (project root or backend/) and fill in what you need.
# Everything is optional; the app runs without any of it.

# Enables the natural-language "ask AegisQ" endpoint (/api/query)
ANTHROPIC_API_KEY=
# Model used for /api/query
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Advanced (defaults shown)
# AEGISQ_RUPEE_MULTIPLIER=500000
# AEGISQ_DB_PATH=
